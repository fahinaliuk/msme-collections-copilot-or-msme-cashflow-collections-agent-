# Backend
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_EXTRACTION_MODEL=gpt-4o-mini
JWT_SECRET=change-me-use-a-long-random-string
SECRET_KEY=change-me-use-a-long-random-string
DATABASE_URL=sqlite+aiosqlite:///msme_agent.db
DATABASE_URL_SYNC=sqlite:///msme_agent.db
MAX_UPLOAD_BYTES=10485760
MAX_EXTRACTION_CHARS=12000
DEBUG=false

# Optional: PostgreSQL (Docker Compose)
# DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/msme_copilot
# DATABASE_URL_SYNC=postgresql://postgres:postgrespassword@localhost:5432/msme_copilot
