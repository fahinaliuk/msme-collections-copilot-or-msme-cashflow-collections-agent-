# =============================================================================
# MSME Collections Copilot — Local Development Environment
# =============================================================================
# Copy this to .env and modify as needed:
#   cp .env.example .env
# =============================================================================

# --- Environment ---
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# --- Database (defaults to async SQLite) ---
# For PostgreSQL (via Docker): postgresql+asyncpg://postgres:postgrespassword@localhost:5432/msme_copilot
DATABASE_URL=sqlite+aiosqlite:///msme_agent.db
DATABASE_URL_SYNC=sqlite:///msme_agent.db

# --- Authentication / JWT ---
JWT_SECRET=dev-jwt-secret-not-for-production
SECRET_KEY=dev-secret-key-not-for-production

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- OpenAI (optional) ---
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_EXTRACTION_MODEL=gpt-4o-mini
MAX_EXTRACTION_CHARS=12000

# --- Upload Limits ---
MAX_UPLOAD_BYTES=10485760

# --- Docker Compose Only ---
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgrespassword
# POSTGRES_DB=msme_copilot