# =============================================================================
# MSME Collections Copilot — Production Environment Variables
# =============================================================================
# Copy this to .env and fill in your values:
#   cp .env.production.example .env
#
# Secrets (generate with `python3 -c "import secrets; print(secrets.token_hex(32))"`):
#   JWT_SECRET=<generated>
#   SECRET_KEY=<generated>
# =============================================================================

# --- Environment ---
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
# Async URL for the FastAPI/SQLAlchemy async driver:
#   PostgreSQL: postgresql+asyncpg://user:pass@host:5432/dbname
#   SQLite (dev): sqlite+aiosqlite:///msme_agent.db
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/msme_copilot

# Sync URL for Alembic migrations (same creds, different driver):
DATABASE_URL_SYNC=postgresql://user:pass@host:5432/msme_copilot

# Connection pool (PostgreSQL only — ignored for SQLite)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# --- Authentication / JWT ---
JWT_SECRET=replace-with-a-cryptographically-random-string
SECRET_KEY=replace-with-a-different-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---
# Comma-separated browser origins that may call the API
CORS_ORIGINS=https://msme-copilot.vercel.app,http://localhost:3000

# --- OpenAI (optional) ---
# Reminders and text extraction work without this key (template fallbacks are used).
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_EXTRACTION_MODEL=gpt-4o-mini

# --- Upload Limits ---
MAX_UPLOAD_BYTES=10485760
MAX_EXTRACTION_CHARS=12000

# --- Docker Compose Only ---
# These are used by docker-compose.yml for the PostgreSQL container:
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=<strong-password>
# POSTGRES_DB=msme_copilot
# BACKEND_PORT=8000
# FRONTEND_PORT=3000