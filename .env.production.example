# Copy to .env before: docker compose up --build
# Generate secrets: openssl rand -hex 32

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=msme_copilot

JWT_SECRET=change-me-run-openssl-rand-hex-32
SECRET_KEY=change-me-run-openssl-rand-hex-32

OPENAI_API_KEY=

# Comma-separated browser origins that may call the API (your public site URL)
CORS_ORIGINS=http://localhost:3000,https://your-domain.com

# Host ports (optional)
BACKEND_PORT=8000
FRONTEND_PORT=3000
